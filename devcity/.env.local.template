# ─── ISLEFOLIO — ENVIRONMENT VARIABLES ───────────────────────────────────────
# Copy this file to: YOUR_PROJECT/.env.local
# NEVER commit .env.local to git (already in .gitignore)

# ── AI AGENTS (at least one required) ────────────────────────────────────────

# Groq — FREE, 14,400 req/day, no credit card
# Get key: console.groq.com → Sign in with GitHub → API Keys → Create
GROQ_API_KEY=

# Gemini — FREE tier (15 req/min)
# Get key: aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get from: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=  # ⚠️ NEVER expose in client code

# ── GITHUB ───────────────────────────────────────────────────────────────────
# Create at: github.com/settings/tokens → Fine-grained token
# Required scopes: read:user, user:email, public_repo
VITE_GITHUB_TOKEN=
GITHUB_TOKEN=  # Same key, used server-side

# ── STRIPE (Week 10 — skip for now) ──────────────────────────────────────────
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
# Resend (contact form emails)
# RESEND_API_KEY=

# Sentry (error monitoring)
# NEXT_PUBLIC_SENTRY_DSN=
